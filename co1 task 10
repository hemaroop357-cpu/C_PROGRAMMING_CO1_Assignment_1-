
#include <stdio.h>

int main(void)
{
    long long bill = 95000; 

    int households[] = {4000, 60000, 800000};

    for (int i = 0; i < 3; i++)
    {
        long long total =
            bill * households[i];

        printf("Households: %d\n", households[i]);

        printf("Total paise: %lld\n", total);

        printf("Total rupees: Rs %.2f\n",
               total / 100.0);

        printf("\n");
    }

    return 0;
}
