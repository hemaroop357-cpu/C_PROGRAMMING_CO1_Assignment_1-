#include <stdio.h>

#define FIXED_CHARGE_PAISE 5000L
#define RATE2_PAISE 225
#define RATE3_PAISE 450

long compute_bill(int units)
{
    long bill = FIXED_CHARGE_PAISE;

    if (units > 100)
    {
        int slab2 = units > 200 ? 100 : units - 100;
        bill += (long)slab2 * RATE2_PAISE;
    }

    if (units > 200)
    {
        bill += (long)(units - 200) * RATE3_PAISE;
    }

#ifdef DEBUG
    printf("Debug: Units = %d\n", units);
    printf("Debug: Bill = %ld\n", bill);
#endif

    return bill;
}

int main(void)
{
    int units = 150;

    long bill = compute_bill(units);

    printf("Bill = Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}
